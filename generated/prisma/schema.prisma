datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum UserRole {
  ADMIN
  HR_MANAGER
  MANAGER
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String            @id @default(uuid())
  name      String
  email     String            @unique
  password  String // クレデンシャルログイン用
  role      UserRole          @default(USER)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  requests  EmployeeRequest[] // ユーザーが作成した申請一覧
}

model UserInvitation {
  id String @id @default(uuid())

  employeeNo String
  lastName   String
  firstName  String
  email      String

  token String @unique

  expectedHireDate DateTime?
  expiresAt        DateTime
  acceptedAt       DateTime?
  cancelledAt      DateTime?

  createdUserId     String?
  createdEmployeeId String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([acceptedAt])
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
}

model Employee {
  id String @id @default(uuid())

  employeeNo String @unique

  lastName  String
  firstName String

  lastNameKana  String?
  firstNameKana String?

  gender Gender?

  birthDate DateTime?

  phoneNumber String?

  address String?

  email String @unique

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  occupation String?

  position String?

  hireDate DateTime?

  employmentType EmploymentType?

  commutingType String?

  status EmployeeStatus @default(ACTIVE)

  retirementDate DateTime?

  healthInsuranceNo String?

  employmentInsuranceNo String?

  photoPath String?

  requests EmployeeRequest[]

  createdAt           DateTime            @default(now())
  employeeMyNumber    EmployeeMyNumber?
  employeeSalary      EmployeeSalary?
  salaryHistories     SalaryHistory[]
  leaveBalance        LeaveBalance?
  employmentHistories EmploymentHistory[]
  leaveGrantHistories LeaveGrantHistory[]
}

enum RequestType {
  ONBOARDING
  DEPARTMENT_CHANGE
  PAID_LEAVE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestHistoryAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
}

model EmploymentHistory {
  id String @id @default(uuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  action EmploymentAction

  effectiveDate DateTime

  reason String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
}

model EmployeeMyNumber {
  id String @id @default(uuid())

  employeeId String @unique

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  encryptedNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeSalary {
  id String @id @default(uuid())

  employeeId String @unique

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  baseSalary Int

  allowance Int @default(0)

  bonus Int @default(0)

  effectiveFrom DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalaryHistory {
  id String @id @default(uuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  baseSalary Int
  allowance  Int @default(0)
  bonus      Int @default(0)

  effectiveFrom DateTime

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([effectiveFrom])
}

model LeaveGrantHistory {
  id String @id @default(uuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  grantDate DateTime

  grantedDays Float

  grantType LeaveGrantType

  note String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([grantDate])
}

model LeaveBalance {
  id String @id @default(uuid())

  employeeId String @unique

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  grantedDays Float @default(0)

  usedDays Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeRequest {
  id              String        @id @default(uuid())
  title           String
  comment         String?
  type            RequestType
  status          RequestStatus @default(PENDING)
  approvalComment String?
  rejectionReason String?

  // 申請作成者（User）との紐付け
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 対象社員（Employee）との紐付け
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  leaveStartDate DateTime?
  leaveEndDate   DateTime?
  leaveDays      Float?

  histories   RequestHistory[]
  attachments RequestAttachment[]

  createdAt DateTime @default(now())
}

model RequestAttachment {
  id       String  @id @default(uuid())
  fileName String
  filePath String
  fileSize Int?
  mimeType String?

  requestId String
  request   EmployeeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model RequestHistory {
  id        String               @id @default(uuid())
  action    RequestHistoryAction
  comment   String?
  actor     String? // セッションから取得した名前を格納する用
  requestId String
  request   EmployeeRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  PART_TIME
  TEMPORARY
}

enum LeaveGrantType {
  LEGAL
  SPECIAL
  MANUAL
  MANUAL_DEDUCT
  MANUAL_CANCEL
  EXPIRED
}

enum EmploymentAction {
  HIRED
  LEAVE_STARTED
  RETURNED
  RETIRED
}

enum EmployeeStatus {
  ACTIVE
  LEAVE
  RETIRED
}

model AuditLog {
  id          String  @id @default(uuid())
  userId      String?
  userName    String?
  action      String
  targetType  String
  targetId    String?
  description String?

  beforeData Json?
  afterData  Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetType])
  @@index([userId])
}
