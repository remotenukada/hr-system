generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String            @id @default(uuid())
  name      String
  email     String            @unique
  password  String
  role      UserRole          @default(USER)
  createdAt DateTime          @default(now())
  isActive  Boolean           @default(true)
  employee  Employee?
  requests  EmployeeRequest[]
}

model UserInvitation {
  id                String                            @id @default(uuid())
  employeeNo        String
  lastName          String
  firstName         String
  email             String
  token             String                            @unique
  expectedHireDate  DateTime?
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdUserId     String?
  createdEmployeeId String?
  createdAt         DateTime                          @default(now())
  cancelledAt       DateTime?
  attachments       EmployeeCertificationAttachment[]

  @@index([email])
  @@index([token])
  @@index([acceptedAt])
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]
}

model Employee {
  id                    String                  @id @default(uuid())
  employeeNo            String                  @unique
  firstName             String
  lastName              String
  email                 String                  @unique
  createdAt             DateTime                @default(now())
  departmentId          String?
  address               String?
  birthDate             DateTime?
  firstNameKana         String?
  gender                Gender?
  hireDate              DateTime?
  lastNameKana          String?
  occupation            String?
  phoneNumber           String?
  position              String?
  commutingType         String?
  employmentType        EmploymentType?
  status                EmployeeStatus          @default(ACTIVE)
  employmentInsuranceNo String?
  healthInsuranceNo     String?
  retirementDate        DateTime?
  photoPath             String?
  userId                String?                 @unique
  emergencyContact      String?
  department            Department?             @relation(fields: [departmentId], references: [id])
  user                  User?                   @relation(fields: [userId], references: [id])
  certifications        EmployeeCertification[]
  employeeMyNumber      EmployeeMyNumber?
  requests              EmployeeRequest[]
  employeeSalary        EmployeeSalary?
  employmentHistories   EmploymentHistory[]
  leaveBalance          LeaveBalance?
  bankAccount           EmployeeBankAccount?
  leaveGrantHistories   LeaveGrantHistory[]
  profileChangeRequests ProfileChangeRequest[]
  salaryHistories       SalaryHistory[]
  dependents            Dependent[]
  dependentRequests     DependentRequest[]
  employmentContracts   EmploymentContract[]
}

model Dependent {
  id                       String    @id @default(uuid())
  employeeId               String
  name                     String
  nameKana                 String?
  relationship             String
  birthDate                DateTime?
  cohabiting               Boolean   @default(true)
  annualIncome             Int?
  healthInsuranceDependent Boolean   @default(true)
  encryptedMyNumber        String?
  note                     String?
  isActive                 Boolean   @default(true)
  endedAt                  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([relationship])
}

model EmploymentHistory {
  id            String           @id @default(uuid())
  employeeId    String
  action        EmploymentAction
  effectiveDate DateTime
  reason        String?
  createdAt     DateTime         @default(now())
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveDate])
}

model EmployeeMyNumber {
  id              String @id @default(uuid())
  employeeId      String @unique
  encryptedNumber String

  status        String  @default("PENDING")
  reviewComment String?

  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeSalary {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  baseSalary    Int
  allowance     Int      @default(0)
  bonus         Int      @default(0)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model SalaryHistory {
  id            String   @id @default(uuid())
  employeeId    String
  baseSalary    Int
  allowance     Int      @default(0)
  bonus         Int      @default(0)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveFrom])
}

model LeaveGrantHistory {
  id          String         @id @default(uuid())
  employeeId  String
  grantDate   DateTime
  grantedDays Float
  grantType   LeaveGrantType
  note        String?
  createdAt   DateTime       @default(now())
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([grantDate])
}

model LeaveBalance {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  grantedDays Float    @default(0)
  usedDays    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeRequest {
  id              String              @id @default(uuid())
  title           String
  employeeId      String?
  createdAt       DateTime            @default(now())
  comment         String?
  approvalComment String?
  rejectionReason String?
  type            RequestType
  userId          String?
  status          RequestStatus       @default(PENDING)
  leaveDays       Float?
  leaveEndDate    DateTime?
  leaveStartDate  DateTime?
  employee        Employee?           @relation(fields: [employeeId], references: [id])
  user            User?               @relation(fields: [userId], references: [id])
  attachments     RequestAttachment[]
  histories       RequestHistory[]
}

model RequestAttachment {
  id        String          @id @default(uuid())
  fileName  String
  filePath  String
  fileSize  Int?
  mimeType  String?
  requestId String
  createdAt DateTime        @default(now())
  request   EmployeeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model RequestHistory {
  id        String               @id @default(uuid())
  action    RequestHistoryAction
  comment   String?
  actor     String?
  requestId String
  createdAt DateTime             @default(now())
  request   EmployeeRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String?
  action      String
  targetType  String
  targetId    String?
  description String?
  createdAt   DateTime @default(now())
  afterData   Json?
  beforeData  Json?

  @@index([createdAt])
  @@index([targetType])
  @@index([userId])
}

model Certification {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  employeeCertifications EmployeeCertification[]
}

model EmployeeCertification {
  id                               String                            @id @default(uuid())
  employeeId                       String
  certificationId                  String
  acquiredDate                     DateTime?
  expiryDate                       DateTime?
  createdAt                        DateTime                          @default(now())
  reviewedAt                       DateTime?
  reviewedBy                       String?
  status                           CertificationStatus               @default(PENDING)
  certification                    Certification                     @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  employee                         Employee                          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeCertificationAttachments EmployeeCertificationAttachment[]

  @@unique([employeeId, certificationId])
}

model EmployeeCertificationAttachment {
  id                      String                @id @default(uuid())
  employeeCertificationId String
  fileName                String
  filePath                String
  fileType                String?
  fileSize                Int?
  createdAt               DateTime              @default(now())
  userInvitationId        String?
  employeeCertification   EmployeeCertification @relation(fields: [employeeCertificationId], references: [id], onDelete: Cascade)
  userInvitation          UserInvitation?       @relation(fields: [userInvitationId], references: [id])

  @@index([employeeCertificationId])
}

model EmployeeBankAccount {
  id         String @id @default(uuid())
  employeeId String @unique

  bankName      String
  branchName    String
  accountType   String
  accountNumber String
  accountHolder String

  bankType    String  @default("BANK")
  yuchoSymbol String?
  yuchoNumber String?

  verifiedAt DateTime?
  verifiedBy String?

  status        String  @default("PENDING")
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attachments EmployeeBankAttachment[]

  @@index([employeeId])
}

model EmployeeBankAttachment {
  id            String @id @default(uuid())
  bankAccountId String

  fileName String
  filePath String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  bankAccount EmployeeBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
}

model DependentRequest {
  id         String @id @default(uuid())
  employeeId String

  type        DependentRequestType @default(ADD)
  dependentId String?

  name         String
  nameKana     String?
  relationship String

  birthDate DateTime?

  annualIncome Int?

  cohabiting Boolean @default(true)

  healthInsuranceDependent Boolean @default(true)

  encryptedMyNumber String?

  note String?

  status RequestStatus @default(PENDING)

  reviewedAt DateTime?
  reviewedBy String?

  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attachments DependentRequestAttachment[]

  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@index([dependentId])
}

model DependentRequestAttachment {
  id                 String @id @default(uuid())
  dependentRequestId String

  fileName String
  filePath String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  dependentRequest DependentRequest @relation(fields: [dependentRequestId], references: [id], onDelete: Cascade)

  @@index([dependentRequestId])
}

model ProfileChangeRequest {
  id                      String              @id @default(uuid())
  employeeId              String
  currentAddress          String?
  newAddress              String?
  currentPhoneNumber      String?
  newPhoneNumber          String?
  currentEmail            String?
  newEmail                String?
  currentEmergencyContact String?
  newEmergencyContact     String?
  status                  ProfileChangeStatus @default(PENDING)
  reviewedAt              DateTime?
  reviewedBy              String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  employee                Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

enum UserRole {
  ADMIN
  USER
  HR_MANAGER
  MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RequestType {
  ONBOARDING
  DEPARTMENT_CHANGE
  OTHER
  PAID_LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DependentRequestType {
  ADD
  UPDATE
  REMOVE
}

enum RequestHistoryAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  PART_TIME
  TEMPORARY
}

enum LeaveGrantType {
  LEGAL
  SPECIAL
  MANUAL
  MANUAL_DEDUCT
  MANUAL_CANCEL
  EXPIRED
}

enum EmploymentAction {
  HIRED
  LEAVE_STARTED
  RETURNED
  RETIRED
  TRANSFER
  POSITION_CHANGE
}

enum EmployeeStatus {
  PRE_HIRE
  ACTIVE
  LEAVE
  RETIRED
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmploymentContract {
  id String @id @default(uuid())

  employeeId String

  contractType String

  startDate DateTime
  endDate   DateTime?

  workplace      String
  jobDescription String

  workStartTime String
  workEndTime   String
  breakMinutes  Int

  holidayRule String
  leaveRule   String?

  wageType   String
  baseSalary Int

  allowanceNote String?

  payClosingDay String?
  payDate       String?

  bonusRule String?
  raiseRule String?

  probationPeriod String?

  contractRenewalRule     String?
  contractRenewalCriteria String?

  retirementRule          String?
  retirementAllowanceRule String?

  socialInsuranceRule     String?
  employmentInsuranceRule String?

  consultationDesk String?

  workRuleLocation String?

  remarks String?

  version Int @default(1)

  isCurrent Boolean @default(true)

  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model CompanySetting {
  id String @id @default(uuid())

  companyName String

  postalCode String?
  address    String?

  phoneNumber String?

  representativeName String?

  consultationDesk String?

  workRuleLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
