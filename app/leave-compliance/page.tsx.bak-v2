import Link from "next/link";
import { prisma } from "@/lib/prisma";
import { requireManager } from "@/lib/auth-guard";

export default async function LeaveCompliancePage() {
  await requireManager();

  const today = new Date();

  const grants =
    await prisma.leaveGrantHistory.findMany({
      where: {
        grantedDays: {
          gte: 10,
        },
        grantType: {
          in: ["LEGAL", "MANUAL"],
        },
      },
      include: {
        employee: true,
      },
      orderBy: {
        grantDate: "desc",
      },
    });

  const rows = grants.map((grant) => {
    const dueDate = new Date(grant.grantDate);
    dueDate.setFullYear(
      dueDate.getFullYear() + 1,
    );

    const elapsedDays = Math.floor(
      (today.getTime() -
        grant.grantDate.getTime()) /
        (1000 * 60 * 60 * 24),
    );

    const remainingDays = Math.floor(
      (dueDate.getTime() - today.getTime()) /
        (1000 * 60 * 60 * 24),
    );

    return {
      grant,
      elapsedDays,
      remainingDays,
    };
  });

  return (
    <main className="mx-auto max-w-7xl p-8">
      <div className="mb-6 flex items-center justify-between">
        <h1 className="text-3xl font-bold">
          年5日取得義務管理
        </h1>

        <Link href="/">
          ダッシュボードへ戻る
        </Link>
      </div>

      <div className="overflow-x-auto rounded border bg-white">
        <table className="w-full text-sm">
          <thead>
            <tr className="bg-gray-50">
              <th className="p-3 text-left">社員</th>
              <th className="p-3 text-left">付与日</th>
              <th className="p-3 text-right">付与日数</th>
              <th className="p-3 text-right">経過日数</th>
              <th className="p-3 text-right">期限まで</th>
            </tr>
          </thead>

          <tbody>
            {rows.map((row) => (
              <tr
                key={row.grant.id}
                className="border-t"
              >
                <td className="p-3">
                  {row.grant.employee
                    ? `${row.grant.employee.lastName} ${row.grant.employee.firstName}`
                    : "-"}
                </td>

                <td className="p-3">
                  {row.grant.grantDate.toLocaleDateString(
                    "ja-JP",
                  )}
                </td>

                <td className="p-3 text-right">
                  {row.grant.grantedDays}
                </td>

                <td className="p-3 text-right">
                  {row.elapsedDays}日
                </td>

                <td className="p-3 text-right">
                  {row.remainingDays}日
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
  );
}
