import BackLink from "@/components/BackLink";
import { auth } from "@/auth";
import { prisma } from "@/lib/prisma";
import { revalidatePath } from "next/cache";
import { redirect } from "next/navigation";
import Link from "next/link";
import { requireManager } from "@/lib/auth-guard";
import { logAudit } from "@/lib/audit-log";

interface PageProps {
  params: Promise<{
    id: string;
  }>;
}

const categoryLabels: Record<string, string> = {
  LEAVE: "休暇申請",
  LATE: "遅刻申請",
  EARLY: "早退申請",
  OUTING: "外出申請",
  CHILD_CARE: "子の看護休暇",
  FAMILY_CARE: "介護休暇",
};

const requestStatusLabels: Record<string, string> = {
  PENDING: "承認待ち",
  APPROVED: "承認済み",
  REJECTED: "却下",
  CANCELLED: "取消",
};

const approvalRoleLabels: Record<string, string> = {
  MANAGER: "部署役職者",
  HR_MANAGER: "人事管理者",
  ADMIN: "システム管理者",
};

const approvalStatusLabels: Record<string, string> = {
  PENDING: "承認待ち",
  APPROVED: "承認済み",
  REJECTED: "却下",
};

const unitLabels: Record<string, string> = {
  DAY: "日",
  HALF_DAY: "半日",
  AM_HALF: "午前休",
  PM_HALF: "午後休",
  HOUR: "時間",
};

function formatDate(value: Date | null) {
  return value ? new Intl.DateTimeFormat("ja-JP").format(value) : "－";
}

function isBalanceManagedRequest(request: {
  requestCategory: string | null;
  type: string;
}) {
  return (
    request.requestCategory === "LEAVE" ||
    request.requestCategory === "CHILD_CARE" ||
    request.requestCategory === "FAMILY_CARE" ||
    (request.requestCategory === null && request.type === "PAID_LEAVE")
  );
}

export default async function RequestDetailPage({ params }: PageProps) {
  const { id } = await params;
  const session = await auth();

  if (!session?.user) {
    redirect("/login");
  }

  const request = await prisma.employeeRequest.findUnique({
    where: { id },
    include: {
      attachments: {
        orderBy: { createdAt: "desc" },
      },
      histories: {
        orderBy: { createdAt: "desc" },
      },
      approvals: {
        orderBy: {
          stepNo: "asc",
        },
      },
      leaveType: true,
      employee: true,
    },
  });

  if (!request) {
    return <div className="p-8">申請が見つかりません。</div>;
  }

  // --- 承認処理（Server Action） ---
  async function approveAction(formData: FormData) {
    "use server";

    await requireManager();

    const currentSession = await auth();
    const approvalComment = formData.get("approvalComment")?.toString() || null;

    const actorName =
      currentSession?.user?.name || currentSession?.user?.email || "管理者";

    const latestRequest = await prisma.employeeRequest.findUnique({
      where: { id },
      include: {
        leaveType: true,
        approvals: {
          orderBy: {
            stepNo: "asc",
          },
        },
      },
    });

    if (!latestRequest || latestRequest.status !== "PENDING") {
      return;
    }

    if (!currentSession?.user) {
      return;
    }

    if (latestRequest.userId === currentSession.user.id) {
      throw new Error("自分自身の申請は承認できません。");
    }

    const actorRole = currentSession.user.role;

    const currentApproval = latestRequest.approvals.find(
      (approval) =>
        approval.stepNo === latestRequest.currentApprovalStep &&
        approval.status === "PENDING",
    );

    if (!currentApproval) {
      throw new Error("現在の承認段階が見つかりません。");
    }

    const canFinalApprove = actorRole === "ADMIN" || actorRole === "HR_MANAGER";

    const canApproveCurrentStep =
      canFinalApprove || actorRole === currentApproval.approverRole;

    if (!canApproveCurrentStep) {
      throw new Error("現在の承認段階を処理する権限がありません。");
    }

    const nextApproval = latestRequest.approvals.find(
      (approval) =>
        approval.stepNo > currentApproval.stepNo &&
        approval.status === "PENDING",
    );

    const isFinalApproval = canFinalApprove || !nextApproval;

    let beforeBalance: unknown = null;
    let afterBalance: unknown = null;

    await prisma.$transaction(async (tx) => {
      if (isFinalApproval) {
        await tx.requestApproval.updateMany({
          where: {
            requestId: latestRequest.id,
            status: "PENDING",
          },
          data: {
            status: "APPROVED",
            approverId: currentSession.user.id,
            approvedAt: new Date(),
            comment:
              approvalComment ||
              (currentApproval.stepNo < latestRequest.approvals.at(-1)!.stepNo
                ? "上位承認者による最終承認"
                : "承認しました"),
          },
        });

        await tx.employeeRequest.update({
          where: { id: latestRequest.id },
          data: {
            status: "APPROVED",
            approvalCompleted: true,
          },
        });
      } else {
        await tx.requestApproval.update({
          where: {
            requestId_stepNo: {
              requestId: latestRequest.id,
              stepNo: currentApproval.stepNo,
            },
          },
          data: {
            status: "APPROVED",
            approverId: currentSession.user.id,
            approvedAt: new Date(),
            comment: approvalComment || "承認しました",
          },
        });

        await tx.employeeRequest.update({
          where: { id: latestRequest.id },
          data: {
            currentApprovalStep: nextApproval!.stepNo,
          },
        });
      }

      if (
        isBalanceManagedRequest(latestRequest) &&
        latestRequest.employeeId &&
        latestRequest.leaveTypeId &&
        latestRequest.leaveDays
      ) {
        const typeBalance = await tx.leaveTypeBalance.findUnique({
          where: {
            employeeId_leaveTypeId: {
              employeeId: latestRequest.employeeId,
              leaveTypeId: latestRequest.leaveTypeId,
            },
          },
        });

        const remainingDays =
          (typeBalance?.grantedDays ?? 0) - (typeBalance?.usedDays ?? 0);

        if (remainingDays < latestRequest.leaveDays) {
          throw new Error(
            `${latestRequest.leaveType?.name ?? "休暇"}の残数不足` +
              `（残数: ${remainingDays}日）`,
          );
        }

        beforeBalance = typeBalance;

        afterBalance = await tx.leaveTypeBalance.update({
          where: {
            employeeId_leaveTypeId: {
              employeeId: latestRequest.employeeId,
              leaveTypeId: latestRequest.leaveTypeId,
            },
          },
          data: {
            usedDays: (typeBalance?.usedDays ?? 0) + latestRequest.leaveDays,
          },
        });

        if (latestRequest.leaveType?.code === "ANNUAL") {
          const annualBalance = await tx.leaveBalance.findUnique({
            where: {
              employeeId: latestRequest.employeeId,
            },
          });

          await tx.leaveBalance.upsert({
            where: {
              employeeId: latestRequest.employeeId,
            },
            update: {
              usedDays:
                (annualBalance?.usedDays ?? 0) + latestRequest.leaveDays,
            },
            create: {
              employeeId: latestRequest.employeeId,
              grantedDays: 0,
              usedDays: latestRequest.leaveDays,
            },
          });
        }
      }

      if (
        latestRequest.requestCategory === "LATE" ||
        latestRequest.requestCategory === "EARLY" ||
        latestRequest.requestCategory === "OUTING"
      ) {
        if (
          !latestRequest.employeeId ||
          !latestRequest.targetDate ||
          !latestRequest.startTime ||
          !latestRequest.endTime
        ) {
          throw new Error("勤怠申請の対象日または時刻が不足しています。");
        }

        if (latestRequest.requestCategory === "LATE") {
          await tx.lateRecord.upsert({
            where: { requestId: latestRequest.id },
            update: {
              employeeId: latestRequest.employeeId,
              targetDate: latestRequest.targetDate,
              scheduledTime: latestRequest.startTime,
              arrivalTime: latestRequest.endTime,
            },
            create: {
              requestId: latestRequest.id,
              employeeId: latestRequest.employeeId,
              targetDate: latestRequest.targetDate,
              scheduledTime: latestRequest.startTime,
              arrivalTime: latestRequest.endTime,
            },
          });
        }

        if (latestRequest.requestCategory === "EARLY") {
          await tx.earlyLeaveRecord.upsert({
            where: { requestId: latestRequest.id },
            update: {
              employeeId: latestRequest.employeeId,
              targetDate: latestRequest.targetDate,
              scheduledTime: latestRequest.startTime,
              leaveTime: latestRequest.endTime,
            },
            create: {
              requestId: latestRequest.id,
              employeeId: latestRequest.employeeId,
              targetDate: latestRequest.targetDate,
              scheduledTime: latestRequest.startTime,
              leaveTime: latestRequest.endTime,
            },
          });
        }

        if (latestRequest.requestCategory === "OUTING") {
          await tx.outingRecord.upsert({
            where: { requestId: latestRequest.id },
            update: {
              employeeId: latestRequest.employeeId,
              targetDate: latestRequest.targetDate,
              startTime: latestRequest.startTime,
              endTime: latestRequest.endTime,
            },
            create: {
              requestId: latestRequest.id,
              employeeId: latestRequest.employeeId,
              targetDate: latestRequest.targetDate,
              startTime: latestRequest.startTime,
              endTime: latestRequest.endTime,
            },
          });
        }
      }

      await tx.employeeRequest.update({
        where: { id },
        data: {
          status: "APPROVED",
          approvalCompleted: true,
          currentApprovalStep: currentApproval.stepNo,
          approvalComment,
          histories: {
            create: {
              action: "APPROVED",
              actor: actorName,
              comment: approvalComment || "申請を承認しました",
            },
          },
        },
      });
    });

    if (
      isBalanceManagedRequest(latestRequest) &&
      latestRequest.employeeId &&
      latestRequest.leaveDays
    ) {
      await logAudit({
        userId: currentSession?.user?.id,
        userName: actorName,
        action: "PAID_LEAVE_APPROVED",
        targetType: "LeaveTypeBalance",
        targetId: latestRequest.employeeId,
        description:
          `${latestRequest.leaveType?.name ?? "休暇"}申請を承認しました。` +
          `取得日数: ${latestRequest.leaveDays}日`,
        beforeData: beforeBalance,
        afterData: afterBalance,
      });
    }

    revalidatePath(`/requests/${id}`);
    revalidatePath("/requests");
    revalidatePath("/requests/my");
    revalidatePath("/leave-balances");
    revalidatePath("/leave-type-balances");
  }

  // --- 承認取消処理（Server Action） ---
  async function cancelApprovalAction(formData: FormData) {
    "use server";

    await requireManager();

    const currentSession = await auth();
    const cancelReason =
      formData.get("cancelReason")?.toString().trim() || null;

    const actorName =
      currentSession?.user?.name || currentSession?.user?.email || "管理者";

    const latestRequest = await prisma.employeeRequest.findUnique({
      where: { id },
      include: {
        leaveType: true,
      },
    });

    if (!latestRequest || latestRequest.status !== "APPROVED") {
      return;
    }

    let beforeBalance: unknown = null;
    let afterBalance: unknown = null;

    await prisma.$transaction(async (tx) => {
      if (
        isBalanceManagedRequest(latestRequest) &&
        latestRequest.employeeId &&
        latestRequest.leaveTypeId &&
        latestRequest.leaveDays
      ) {
        const typeBalance = await tx.leaveTypeBalance.findUnique({
          where: {
            employeeId_leaveTypeId: {
              employeeId: latestRequest.employeeId,
              leaveTypeId: latestRequest.leaveTypeId,
            },
          },
        });

        if (!typeBalance) {
          throw new Error("休暇別残高が見つかりません。");
        }

        beforeBalance = typeBalance;

        afterBalance = await tx.leaveTypeBalance.update({
          where: {
            employeeId_leaveTypeId: {
              employeeId: latestRequest.employeeId,
              leaveTypeId: latestRequest.leaveTypeId,
            },
          },
          data: {
            usedDays: Math.max(
              0,
              typeBalance.usedDays - latestRequest.leaveDays,
            ),
          },
        });

        if (latestRequest.leaveType?.code === "ANNUAL") {
          const annualBalance = await tx.leaveBalance.findUnique({
            where: {
              employeeId: latestRequest.employeeId,
            },
          });

          if (annualBalance) {
            await tx.leaveBalance.update({
              where: {
                employeeId: latestRequest.employeeId,
              },
              data: {
                usedDays: Math.max(
                  0,
                  annualBalance.usedDays - latestRequest.leaveDays,
                ),
              },
            });
          }
        }
      }

      if (latestRequest.requestCategory === "LATE") {
        await tx.lateRecord.deleteMany({
          where: { requestId: latestRequest.id },
        });
      }

      if (latestRequest.requestCategory === "EARLY") {
        await tx.earlyLeaveRecord.deleteMany({
          where: { requestId: latestRequest.id },
        });
      }

      if (latestRequest.requestCategory === "OUTING") {
        await tx.outingRecord.deleteMany({
          where: { requestId: latestRequest.id },
        });
      }

      await tx.employeeRequest.update({
        where: { id },
        data: {
          status: "CANCELLED",
          histories: {
            create: {
              action: "CANCELLED",
              actor: actorName,
              comment: cancelReason || "承認を取り消しました",
            },
          },
        },
      });
    });

    await logAudit({
      userId: currentSession?.user?.id,
      userName: actorName,
      action: "LEAVE_APPROVAL_CANCELLED",
      targetType: "EmployeeRequest",
      targetId: id,
      description:
        `${latestRequest.leaveType?.name ?? "休暇"}の承認を取消` +
        ` ${latestRequest.leaveDays ?? 0}日`,
      beforeData: beforeBalance,
      afterData: afterBalance,
    });

    revalidatePath(`/requests/${id}`);
    revalidatePath("/requests");
    revalidatePath("/leave-balances");
    revalidatePath("/leave-type-balances");
  }

  // --- 却下処理（Server Action） ---
  async function rejectAction(formData: FormData) {
    "use server";

    await requireManager();

    const currentSession = await auth();
    const rejectionReason = formData.get("rejectionReason")?.toString() || null;

    const actorName =
      currentSession?.user?.name || currentSession?.user?.email || "管理者";

    await prisma.employeeRequest.update({
      where: { id },
      data: {
        status: "REJECTED",
        histories: {
          create: {
            action: "REJECTED",
            actor: actorName,
            comment: rejectionReason || "申請を却下しました",
          },
        },
      },
    });

    revalidatePath(`/requests/${id}`);
    revalidatePath("/requests");
  }

  const canApprove =
    session.user.role === "ADMIN" ||
    session.user.role === "HR_MANAGER" ||
    session.user.role === "MANAGER";

  return (
    <main className="p-8 max-w-4xl mx-auto">
      <BackLink href="/requests" label="申請一覧へ戻る" />
      <div className="mb-6">
        <h1 className="text-3xl font-bold mt-2">{request.title}</h1>
        <p className="text-gray-500 mt-1">
          ステータス:{" "}
          <span className="font-semibold text-black">
            {requestStatusLabels[request.status] ?? request.status}
          </span>
        </p>
      </div>

      <div className="mb-8 rounded border bg-white p-6">
        <h2 className="mb-4 text-xl font-bold">申請情報</h2>

        <div className="grid gap-3 md:grid-cols-2">
          <div>
            <div className="text-sm text-gray-500">申請区分</div>
            <div className="font-medium">
              {request.requestCategory
                ? categoryLabels[request.requestCategory]
                : request.title}
            </div>
          </div>

          <div>
            <div className="text-sm text-gray-500">休暇種別</div>
            <div className="font-medium">{request.leaveType?.name ?? "－"}</div>
          </div>

          <div>
            <div className="text-sm text-gray-500">対象日</div>
            <div className="font-medium">
              {formatDate(
                request.requestCategory === "LEAVE"
                  ? request.leaveStartDate
                  : request.targetDate,
              )}
            </div>
          </div>

          <div>
            <div className="text-sm text-gray-500">取得単位</div>
            <div className="font-medium">
              {request.unitType ? unitLabels[request.unitType] : "－"}
            </div>
          </div>

          <div>
            <div className="text-sm text-gray-500">開始時刻</div>
            <div className="font-medium">{request.startTime ?? "－"}</div>
          </div>

          <div>
            <div className="text-sm text-gray-500">終了時刻</div>
            <div className="font-medium">{request.endTime ?? "－"}</div>
          </div>

          <div>
            <div className="text-sm text-gray-500">取得日数</div>
            <div className="font-medium">{request.leaveDays ?? "－"}</div>
          </div>

          <div>
            <div className="text-sm text-gray-500">取得時間</div>
            <div className="font-medium">{request.hours ?? "－"}</div>
          </div>
        </div>
      </div>

      <div className="bg-white p-6 rounded border mb-8">
        <h2 className="text-xl font-bold mb-2">申請内容</h2>
        <p className="text-gray-700 whitespace-pre-wrap">
          {request.comment || "コメントなし"}
        </p>
      </div>

      <div className="bg-white p-6 rounded border mb-8">
        <h2 className="text-xl font-bold mb-4">添付ファイル</h2>

        {request.attachments.length === 0 ? (
          <p className="text-gray-500">添付ファイルはありません。</p>
        ) : (
          <ul className="space-y-3">
            {request.attachments.map((attachment) => (
              <li
                key={attachment.id}
                className="flex items-center justify-between rounded border bg-gray-50 p-3"
              >
                <div>
                  <p className="font-medium text-gray-800">
                    {attachment.fileName}
                  </p>
                  <p className="text-xs text-gray-500">
                    {attachment.mimeType || "unknown"} /{" "}
                    {attachment.fileSize
                      ? `${Math.ceil(attachment.fileSize / 1024)} KB`
                      : "-"}
                  </p>
                </div>

                <a
                  href={attachment.filePath}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="rounded border bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-100"
                >
                  開く
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <section className="mb-8 rounded border bg-white p-6">
        <h2 className="mb-4 text-xl font-bold">承認状況</h2>

        {request.approvals.length === 0 ? (
          <p className="text-sm text-gray-500">
            承認ルートが設定されていません。
          </p>
        ) : (
          <div className="space-y-3">
            {request.approvals.map((approval) => {
              const isCurrent =
                request.status === "PENDING" &&
                approval.stepNo === request.currentApprovalStep;

              const statusLabel =
                approval.status === "APPROVED"
                  ? "承認済み"
                  : approval.status === "REJECTED"
                    ? "却下"
                    : isCurrent
                      ? "承認待ち"
                      : "待機中";

              const statusClass =
                approval.status === "APPROVED"
                  ? "bg-green-100 text-green-800"
                  : approval.status === "REJECTED"
                    ? "bg-red-100 text-red-800"
                    : isCurrent
                      ? "bg-amber-100 text-amber-800"
                      : "bg-gray-100 text-gray-600";

              return (
                <div
                  key={approval.id}
                  className={`rounded-lg border p-4 ${
                    isCurrent ? "border-amber-300 bg-amber-50" : "bg-white"
                  }`}
                >
                  <div className="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <span className="font-semibold">
                        Step {approval.stepNo}
                      </span>
                      <span className="ml-3 text-gray-700">
                        {approvalRoleLabels[approval.approverRole] ??
                          approval.approverRole}
                      </span>
                    </div>

                    <span
                      className={`rounded-full px-3 py-1 text-xs font-medium ${statusClass}`}
                    >
                      {statusLabel}
                    </span>
                  </div>

                  {approval.approvedAt && (
                    <p className="mt-2 text-xs text-gray-500">
                      処理日時：
                      {new Date(approval.approvedAt).toLocaleString("ja-JP")}
                    </p>
                  )}

                  {approval.comment && (
                    <p className="mt-2 text-sm text-gray-700">
                      {approval.comment}
                    </p>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </section>

      {/* 管理者用：承認・却下フォーム */}
      {canApprove && request.status === "PENDING" && (
        <div className="bg-gray-50 p-6 rounded border mb-8 space-y-6">
          <h2 className="text-xl font-bold">承認操作</h2>

          {/* 承認フォーム */}
          <form action={approveAction} className="space-y-2">
            <input
              type="text"
              name="approvalComment"
              placeholder="承認コメント（任意）"
              className="w-full p-2 border rounded"
            />
            <button
              type="submit"
              className="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 font-medium"
            >
              承認する
            </button>
          </form>

          <hr />

          {/* 却下フォーム */}
          <form action={rejectAction} className="space-y-2">
            <input
              type="text"
              name="rejectionReason"
              placeholder="却下理由（任意）"
              className="w-full p-2 border rounded"
            />
            <button
              type="submit"
              className="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-medium"
            >
              却下する
            </button>
          </form>
        </div>
      )}

      {canApprove && request.status === "APPROVED" && (
        <div className="mb-8 rounded border border-orange-200 bg-orange-50 p-6">
          <h2 className="mb-3 text-xl font-bold">承認取消</h2>

          <form action={cancelApprovalAction} className="space-y-4">
            <input
              type="text"
              name="cancelReason"
              placeholder="取消理由（任意）"
              className="w-full rounded border p-2"
            />

            <button
              type="submit"
              className="rounded bg-orange-600 px-4 py-2 font-medium text-white hover:bg-orange-700"
            >
              承認を取り消す
            </button>
          </form>
        </div>
      )}

      {/* 履歴表示 */}
      <div className="border-t pt-6">
        <h2 className="text-xl font-bold mb-4">処理履歴</h2>
        <div className="space-y-4">
          {request.histories.map((h) => (
            <div key={h.id} className="p-4 bg-gray-50 rounded border">
              <div className="flex justify-between text-sm text-gray-600">
                <span>
                  アクション: <strong>{h.action}</strong>
                </span>
                <span>
                  担当者: <strong>{h.actor}</strong>
                </span>
              </div>
              <p className="mt-2">{h.comment}</p>
              <span className="text-xs text-gray-400 mt-1 block">
                {new Date(h.createdAt).toLocaleString("ja-JP")}
              </span>
            </div>
          ))}
        </div>
      </div>
    </main>
  );
}
