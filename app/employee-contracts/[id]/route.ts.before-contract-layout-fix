import { prisma } from "@/lib/prisma";
import {
  PDFDocument,
  StandardFonts,
  rgb,
} from "pdf-lib";
import fontkit from "@pdf-lib/fontkit";
import fs from "fs";

export const runtime = "nodejs";

type RouteContext = {
  params: Promise<{
    id: string;
  }>;
};

const FONT_PATH = "/usr/share/fonts/opentype/ipafont-gothic/ipag.ttf";
const EXPORT_DIR = "/data/hr-system/exports/contracts";

function formatDate(date: Date | null) {
  if (!date) {
    return "-";
  }

  return new Date(date).toLocaleDateString("ja-JP");
}

function formatCurrency(amount: number | null | undefined) {
  if (amount == null) {
    return "-";
  }

  return `${amount.toLocaleString("ja-JP")}円`;
}

function valueOrDash(value: string | null | undefined) {
  return value && value.trim() ? value : "-";
}



function formatEmploymentType(value: string | null | undefined) {
  switch (value) {
    case "FULL_TIME":
      return "常勤"
    case "PART_TIME":
      return "非常勤"
    case "CONTRACT":
      return "契約社員"
    case "TEMPORARY":
      return "臨時職員"
    default:
      return value || "-"
  }
}


function compactText(value: string, maxLength = 42) {
  const text = value.replace(/\s+/g, " ").trim();

  if (text.length <= maxLength) {
    return text;
  }

  return `${text.slice(0, maxLength - 1)}…`;
}

export async function GET(
  _request: Request,
  { params }: RouteContext,
) {
  const { id } = await params;

  const contract =
    await prisma.employmentContract.findUnique({
      where: {
        id,
      },
      include: {
        employee: true,
        workSchedules: {
          orderBy: {
            sortOrder: "asc",
          },
        },
      },
    });

  if (!contract) {
    return new Response("Employment contract not found", {
      status: 404,
    });
  }

  const company =
    await prisma.companySetting.findFirst();

  const consent =
    await prisma.employmentContractConsent.findFirst({
      where: {
        employmentContractId: contract.id,
        signatureImagePath: {
          not: null,
        },
      },
      orderBy: {
        consentedAt: "desc",
      },
    });

  const pdfDoc = await PDFDocument.create();
  pdfDoc.registerFontkit(fontkit);

  let font: Awaited<
    ReturnType<typeof pdfDoc.embedFont>
  >;

  if (fs.existsSync(FONT_PATH)) {
    const fontBytes = fs.readFileSync(FONT_PATH);
    font = await pdfDoc.embedFont(fontBytes, {
      subset: false,
    });
  } else {
    font = await pdfDoc.embedFont(StandardFonts.Helvetica);
  }

  const page = pdfDoc.addPage([595.28, 841.89]);
  const { height } = page.getSize();

  let y = height - 55;

  function drawText(
    text: string,
    x: number,
    currentY: number,
    size = 8,
    color = rgb(0.1, 0.1, 0.1),
  ) {
    page.drawText(text, {
      x,
      y: currentY,
      size,
      font,
      color,
    });
  }

  function sectionTitle(title: string) {
    y -= 14;

    page.drawRectangle({
      x: 40,
      y: y - 3,
      width: 515,
      height: 13,
      color: rgb(0.9, 0.94, 1),
    });

    drawText(title, 45, y, 8.5, rgb(0.05, 0.18, 0.45));

    y -= 12;
  }

  function row(label: string, value: string) {
    page.drawRectangle({
      x: 40,
      y: y - 3,
      width: 110,
      height: 13,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(0.98, 0.98, 0.98),
    });

    page.drawRectangle({
      x: 150,
      y: y - 3,
      width: 405,
      height: 13,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(1, 1, 1),
    });

    drawText(label, 45, y + 1, 7.2, rgb(0.25, 0.25, 0.25));
    drawText(compactText(value), 155, y + 1, 7.2);

    y -= 13;
  }


  function allowanceBlock(value: string) {
    const lines = value
      ? value
          .split(/\r?\n/)
          .map(v => v.trim())
          .filter(Boolean)
      : ["-"];

    const boxHeight =
      Math.max(20, lines.length * 12 + 8);

    page.drawRectangle({
      x: 40,
      y: y - boxHeight + 4,
      width: 110,
      height: boxHeight,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(0.98, 0.98, 0.98),
    });

    page.drawRectangle({
      x: 150,
      y: y - boxHeight + 4,
      width: 405,
      height: boxHeight,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(1, 1, 1),
    });

    drawText("手当", 45, y - 4, 7.2);

    let lineY = y - 4;

    for (const line of lines) {
      drawText(`・${line}`, 155, lineY, 7.2);
      lineY -= 12;
    }

    y -= boxHeight;
  }

  function twoColRow(
    label1: string,
    value1: string,
    label2: string,
    value2: string,
  ) {
    page.drawRectangle({
      x: 40,
      y: y - 3,
      width: 75,
      height: 13,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(0.98, 0.98, 0.98),
    });

    page.drawRectangle({
      x: 115,
      y: y - 3,
      width: 165,
      height: 13,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(1, 1, 1),
    });

    page.drawRectangle({
      x: 280,
      y: y - 3,
      width: 75,
      height: 13,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(0.98, 0.98, 0.98),
    });

    page.drawRectangle({
      x: 355,
      y: y - 3,
      width: 200,
      height: 13,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(1, 1, 1),
    });

    drawText(label1, 45, y + 1, 7.2, rgb(0.25, 0.25, 0.25));
    drawText(compactText(value1, 18), 120, y + 1, 7.2);
    drawText(label2, 285, y + 1, 7.2, rgb(0.25, 0.25, 0.25));
    drawText(compactText(value2, 22), 360, y + 1, 7.2);

    y -= 13;
  }

  if (company) {
    drawText(
      company.companyName,
      40,
      y,
      10,
      rgb(0.05, 0.05, 0.05),
    );

    drawText(
      `所在地: ${`${company.postalCode ?? ""} ${company.address ?? ""}`.trim()}`,
      40,
      y - 13,
      7,
      rgb(0.25, 0.25, 0.25),
    );

    drawText(
      `代表者: ${company.representativeName ?? "-"}　電話: ${company.phoneNumber ?? "-"}`,
      40,
      y - 25,
      7,
      rgb(0.25, 0.25, 0.25),
    );
  }

  drawText(
    "雇用条件通知書兼雇用契約書",
    205,
    y,
    14,
    rgb(0.05, 0.08, 0.18),
  );

  drawText(
    `作成日: ${new Date().toLocaleDateString("ja-JP")}　Version: v${contract.version}`,
    390,
    y - 25,
    7,
    rgb(0.35, 0.35, 0.35),
  );

  y -= 42;

  sectionTitle("契約情報・就業条件");

  const blockTopY = y;

  page.drawRectangle({
    x: 40,
    y: blockTopY - 132,
    width: 245,
    height: 132,
    borderWidth: 0.5,
    borderColor: rgb(0.72, 0.72, 0.72),
  });

  drawText("契約情報", 50, blockTopY - 12, 8);

  drawText(
    `氏名: ${contract.employee.lastName} ${contract.employee.firstName}`,
    50,
    blockTopY - 28,
    7,
  );

  drawText(
    `住所: ${valueOrDash(contract.employee.address)}`,
    50,
    blockTopY - 42,
    7,
  );

  drawText(
    `雇用形態: ${formatEmploymentType(contract.employee.employmentType)}`,
    50,
    blockTopY - 56,
    7,
  );

  drawText(
    `契約区分: ${contract.contractType}`,
    50,
    blockTopY - 70,
    7,
  );

  drawText(
    `契約期間: ${formatDate(contract.startDate)} ～ ${formatDate(contract.endDate)}`,
    50,
    blockTopY - 70,
    7,
  );

  drawText(
    `契約更新: ${valueOrDash(contract.contractRenewalRule)}`,
    50,
    blockTopY - 84,
    7,
  );

  page.drawRectangle({
    x: 310,
    y: blockTopY - 132,
    width: 245,
    height: 132,
    borderWidth: 0.5,
    borderColor: rgb(0.72, 0.72, 0.72),
  });

  drawText("就業条件", 320, blockTopY - 12, 8);

  drawText(
    `就業場所: ${contract.workplace}`,
    320,
    blockTopY - 28,
    7,
  );

  drawText(
    `業務内容: ${contract.jobDescription}`,
    320,
    blockTopY - 42,
    7,
  );

  const scheduleLines =
    contract.workSchedules.length > 0
      ? contract.workSchedules.map(
          (schedule) =>
            `${schedule.name} ${schedule.startTime}～${schedule.endTime}（休憩${schedule.breakMinutes}分）`,
        )
      : [
          `${contract.workStartTime}～${contract.workEndTime}（休憩${contract.breakMinutes}分）`,
        ];

  drawText("勤務時間", 320, blockTopY - 56, 7);

  scheduleLines.slice(0, 4).forEach((line, index) => {
    drawText(
      `・${line}`,
      320,
      blockTopY - 68 - index * 12,
      6.6,
    );
  });

  drawText(
    `休日・休暇: ${valueOrDash(contract.holidayRule)} / ${valueOrDash(contract.leaveRule)}`,
    320,
    blockTopY - 116,
    7,
  );

  y = blockTopY - 152;

  sectionTitle("賃金・社会保険");

  const salaryRowHeight = 15;
  const salaryX = 40;
  const salaryWidth = 515;
  const salaryHalfWidth = salaryWidth / 2;
  const salaryLabelWidth = 72;

  function salaryCell(
    x: number,
    currentY: number,
    label: string,
    value: string,
    width = salaryHalfWidth,
  ) {
    page.drawRectangle({
      x,
      y: currentY - salaryRowHeight + 3,
      width: salaryLabelWidth,
      height: salaryRowHeight,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(0.98, 0.98, 0.98),
    });

    page.drawRectangle({
      x: x + salaryLabelWidth,
      y: currentY - salaryRowHeight + 3,
      width: width - salaryLabelWidth,
      height: salaryRowHeight,
      borderWidth: 0.5,
      borderColor: rgb(0.72, 0.72, 0.72),
      color: rgb(1, 1, 1),
    });

    drawText(
      label,
      x + 5,
      currentY - 6,
      6.8,
      rgb(0.25, 0.25, 0.25),
    );

    drawText(
      compactText(value, 24),
      x + salaryLabelWidth + 5,
      currentY - 6,
      6.8,
    );
  }

  salaryCell(
    salaryX,
    y,
    "基本給",
    formatCurrency(contract.baseSalary),
  );

  salaryCell(
    salaryX + salaryHalfWidth,
    y,
    "賃金支払",
    `${valueOrDash(contract.payClosingDay)}締め ／ ${valueOrDash(contract.payDate)}支払`,
  );

  y -= salaryRowHeight;

  const allowanceLines = valueOrDash(contract.allowanceNote)
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  const visibleAllowanceLines =
    allowanceLines.length > 0
      ? allowanceLines.slice(0, 4)
      : ["-"];

  const allowanceHeight =
    Math.max(32, visibleAllowanceLines.length * 11 + 16);

  page.drawRectangle({
    x: salaryX,
    y: y - allowanceHeight + 4,
    width: salaryLabelWidth,
    height: allowanceHeight,
    borderWidth: 0.5,
    borderColor: rgb(0.72, 0.72, 0.72),
    color: rgb(0.98, 0.98, 0.98),
  });

  page.drawRectangle({
    x: salaryX + salaryLabelWidth,
    y: y - allowanceHeight + 4,
    width: salaryWidth - salaryLabelWidth,
    height: allowanceHeight,
    borderWidth: 0.5,
    borderColor: rgb(0.72, 0.72, 0.72),
    color: rgb(1, 1, 1),
  });

  drawText(
    "手当",
    salaryX + 5,
    y - 7,
    6.8,
    rgb(0.25, 0.25, 0.25),
  );

  let allowanceY = y - 7;

  for (const line of visibleAllowanceLines) {
    drawText(
      `・${line}`,
      salaryX + salaryLabelWidth + 5,
      allowanceY,
      6.8,
    );

    allowanceY -= 11;
  }

  if (allowanceLines.length > visibleAllowanceLines.length) {
    drawText(
      "・ほか",
      salaryX + salaryLabelWidth + 5,
      allowanceY,
      6.8,
    );
  }

  y -= allowanceHeight;

  salaryCell(
    salaryX,
    y,
    "昇給",
    valueOrDash(contract.raiseRule),
  );

  salaryCell(
    salaryX + salaryHalfWidth,
    y,
    "賞与",
    valueOrDash(contract.bonusRule),
  );

  y -= salaryRowHeight;

  salaryCell(
    salaryX,
    y,
    "退職金",
    valueOrDash(contract.retirementAllowanceRule),
  );

  salaryCell(
    salaryX + salaryHalfWidth,
    y,
    "退職事項",
    valueOrDash(contract.retirementRule),
  );

  y -= salaryRowHeight;

  salaryCell(
    salaryX,
    y,
    "社会保険",
    valueOrDash(contract.socialInsuranceRule),
  );

  salaryCell(
    salaryX + salaryHalfWidth,
    y,
    "雇用保険",
    valueOrDash(contract.employmentInsuranceRule),
  );

  y -= salaryRowHeight;

  salaryCell(
    salaryX,
    y,
    "相談窓口",
    valueOrDash(contract.consultationDesk),
  );

  salaryCell(
    salaryX + salaryHalfWidth,
    y,
    "就業規則",
    valueOrDash(contract.workRuleLocation),
  );

  y -= salaryRowHeight + 8;

  const signatureY = 130;

  page.drawRectangle({
    x: 40,
    y: signatureY + 94,
    width: 515,
    height: 16,
    color: rgb(0.9, 0.94, 1),
  });

  drawText(
    "契約確認・署名欄",
    45,
    signatureY + 99,
    8.5,
    rgb(0.05, 0.18, 0.45),
  );

  page.drawRectangle({
    x: 40,
    y: signatureY,
    width: 515,
    height: 88,
    borderWidth: 0.5,
    borderColor: rgb(0.72, 0.72, 0.72),
    color: rgb(1, 1, 1),
  });

  page.drawRectangle({
    x: 305,
    y: signatureY,
    width: 250,
    height: 88,
    borderWidth: 0.5,
    borderColor: rgb(0.72, 0.72, 0.72),
    color: rgb(1, 1, 1),
  });

  drawText("労働者確認欄", 50, signatureY + 72, 8, rgb(0.05, 0.18, 0.45));
  drawText(
    `氏名: ${contract.employee.lastName} ${contract.employee.firstName}`,
    50,
    signatureY + 57,
    7.2,
  );
  drawText(
    `住所: ${valueOrDash(contract.employee.address)}`,
    50,
    signatureY + 43,
    6.8,
  );

  if (consent?.signatureImagePath) {
    drawText(
      `同意日時: ${new Date(consent.consentedAt).toLocaleString("ja-JP")}`,
      50,
      signatureY + 29,
      6.8,
      rgb(0.35, 0.35, 0.35),
    );

    const signatureFilePath =
      consent.signatureImagePath.replace(
        /^\/signatures/,
        "/data/hr-system/signatures",
      );

    if (fs.existsSync(signatureFilePath)) {
      const signatureBytes =
        fs.readFileSync(signatureFilePath);

      const signatureImage =
        await pdfDoc.embedPng(signatureBytes);

      page.drawImage(signatureImage, {
        x: 315,
        y: signatureY + 5,
        width: 145,
        height: 34,
      });
    }
  } else {
    drawText(
      "署名",
      315,
      signatureY + 18,
      6.8,
      rgb(0.35, 0.35, 0.35),
    );

    page.drawLine({
      start: {
        x: 345,
        y: signatureY + 18,
      },
      end: {
        x: 535,
        y: signatureY + 18,
      },
      thickness: 0.5,
      color: rgb(0.5, 0.5, 0.5),
    });
  }

  drawText(
    "本書は労働条件通知書として交付し、労働者の電子同意をもって雇用契約の確認記録とします。",
    40,
    35,
    6.5,
    rgb(0.35, 0.35, 0.35),
  );

  const pdfBytes = await pdfDoc.save();
  const pdfBuffer = Buffer.from(pdfBytes);

  const contractDir = `${EXPORT_DIR}/${contract.id}`;

  fs.mkdirSync(contractDir, {
    recursive: true,
  });

  const safeEmployeeNo = contract.employee.employeeNo.replace(
    /[^a-zA-Z0-9_-]/g,
    "_",
  );

  const fileName =
    `employment-contract-${safeEmployeeNo}-v${contract.version}.pdf`;

  const filePath = `${contractDir}/${fileName}`;

  fs.writeFileSync(filePath, pdfBuffer);

  return new Response(pdfBuffer, {
    status: 200,
    headers: {
      "Content-Type": "application/pdf",
      "Content-Disposition": `inline; filename="employment-contract-${contract.employee.employeeNo}.pdf"`,
    },
  });
}
