                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <details className="mt-6 rounded border bg-gray-50 p-4">
        <summary className="cursor-pointer font-medium">
          JSONデータを表示
        </summary>

        <div className="mt-4 grid gap-6 lg:grid-cols-2">
